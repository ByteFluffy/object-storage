{
  "name": "@starrank-soft/object-storage",
  "version": "0.1.7",
  "description": "Shared object storage operations for server upload, browser direct upload, and explicit finalize.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starrank-soft/object-storage.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./drivers/memory": {
      "types": "./dist/drivers/memory.d.ts",
      "import": "./dist/drivers/memory.js"
    },
    "./drivers/tos": {
      "types": "./dist/drivers/tos.d.ts",
      "import": "./dist/drivers/tos.js"
    },
    "./drivers/s3": {
      "types": "./dist/drivers/s3.d.ts",
      "import": "./dist/drivers/s3.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/fit.d.ts",
      "import": "./dist/delivery/fit.js"
    },
    "./plugins/probe": {
      "types": "./dist/plugins/probe/index.d.ts",
      "import": "./dist/plugins/probe/index.js"
    },
    "./plugins/cleanup": {
      "types": "./dist/plugins/cleanup/index.d.ts",
      "import": "./dist/plugins/cleanup/index.js"
    },
    "./plugins/image": {
      "types": "./dist/plugins/image/index.d.ts",
      "import": "./dist/plugins/image/index.js"
    },
    "./build/esbuild": {
      "types": "./dist/build/esbuild.d.ts",
      "import": "./dist/build/esbuild.js"
    },
    "./plugins/media": {
      "types": "./dist/plugins/media/index.d.ts",
      "import": "./dist/plugins/media/index.js"
    }
  },
  "scripts": {
    "prepack": "npm run build && npm run typecheck && npm test && npm run test:package",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run tests/unit tests/package/entry-boundary.test.ts",
    "test:package": "vitest run tests/package",
    "test:integration": "node scripts/integration-pending.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "3.1007.0",
    "@aws-sdk/s3-request-presigner": "3.1007.0",
    "@volcengine/tos-sdk": "2.9.1",
    "esbuild": "^0.28.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@volcengine/tos-sdk": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1007.0",
    "@aws-sdk/s3-request-presigner": "3.1007.0",
    "@types/node": "22.19.1",
    "@volcengine/tos-sdk": "2.9.1",
    "esbuild": "0.28.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "sharp": "0.34.5"
  }
}
